module Skia
  VERSION: String

  class Error < StandardError
  end

  class NullPointerError < Error
  end

  class ClosedError < Error
  end

  class EncodingError < Error
  end

  class DecodingError < Error
  end

  class FileNotFoundError < Error
  end

  class UnsupportedOperationError < Error
  end

  class Card
    DEFAULT_WIDTH: Integer
    DEFAULT_HEIGHT: Integer
    DEFAULT_COLORS: Array[Color]

    attr_reader title: String
    attr_reader author: String?
    attr_reader site_name: String?
    attr_reader tags: Array[String]
    attr_reader width: Integer
    attr_reader height: Integer

    def initialize: (title: String, ?author: String?, ?site_name: String?, ?tags: Array[String], ?width: Integer, ?height: Integer, ?colors: Array[Color | Integer]) -> void
    def render: () -> Surface
    def save: (String path, ?format: Symbol?, ?quality: Integer) -> Card
  end

  class ActiveStorageTransformer
    SUPPORTED_TRANSFORMATIONS: Array[Symbol]
    attr_reader transformations: Hash[Symbol, untyped]

    def initialize: (Hash[Symbol | String, untyped] transformations) -> void
    def transform: (untyped file, format: Symbol | String) { (untyped) -> untyped } -> untyped
  end

  class Document < Base
    def self.create_pdf: (String path, ?metadata: Hash[Symbol, untyped]?) -> Document
                        | (String path, ?metadata: Hash[Symbol, untyped]?) { (Document) -> untyped } -> untyped
    def self.create_pdf_stream: (?metadata: Hash[Symbol, untyped]?) -> Document
                               | (?metadata: Hash[Symbol, untyped]?) { (Document) -> untyped } -> untyped
    def self.create_xps: (String path, ?dpi: Numeric) -> Document
                        | (String path, ?dpi: Numeric) { (Document) -> untyped } -> untyped
    def self.create_xps_stream: (?dpi: Numeric) -> Document
                               | (?dpi: Numeric) { (Document) -> untyped } -> untyped
    def self.xps_available?: () -> bool
    def begin_page: (Numeric width, Numeric height, ?Rect? rect, ?content_rect: Rect?) -> Canvas
                  | (Numeric width, Numeric height, ?Rect? rect, ?content_rect: Rect?) { (Canvas) -> untyped } -> untyped
    def page: (Numeric width, Numeric height, ?content_rect: Rect?) { (Canvas) -> untyped } -> untyped
    def end_page: () -> void
    def close: () -> void
    def abort: () -> void
    def to_data: () -> Data
    def closed?: () -> bool
  end

  class Base
    def initialize: (untyped ptr, ?Symbol? release_method, ?owner: untyped) -> void
    def ptr: () -> untyped
    def to_ptr: () -> untyped
    def null?: () -> bool
    def closed?: () -> bool
    def close: () -> self
    def dispose: () -> self
  end

  class Color
    TRANSPARENT: Color
    BLACK: Color
    WHITE: Color
    RED: Color
    GREEN: Color
    BLUE: Color
    YELLOW: Color
    CYAN: Color
    MAGENTA: Color

    def initialize: (Integer value) -> void
    def self.from_argb: (Integer alpha, Integer red, Integer green, Integer blue) -> Color
    def self.from_rgb: (Integer red, Integer green, Integer blue) -> Color
    def self.from_hex: (String value) -> Color
    def to_i: () -> Integer
    def to_hex: () -> String
  end

  class Point
    attr_reader x: Numeric
    attr_reader y: Numeric

    def initialize: (Numeric x, Numeric y) -> void
    def +: (Point other) -> Point
    def -: (Point other) -> Point
  end

  class Rect
    attr_reader left: Numeric
    attr_reader top: Numeric
    attr_reader right: Numeric
    attr_reader bottom: Numeric

    def initialize: (Numeric left, Numeric top, Numeric right, Numeric bottom) -> void
    def self.from_xywh: (Numeric x, Numeric y, Numeric width, Numeric height) -> Rect
    def self.from_wh: (Numeric width, Numeric height) -> Rect
    def width: () -> Numeric
    def height: () -> Numeric
    def empty?: () -> bool
  end

  class IRect
    attr_reader left: Integer
    attr_reader top: Integer
    attr_reader right: Integer
    attr_reader bottom: Integer

    def initialize: (?Numeric left, ?Numeric top, ?Numeric right, ?Numeric bottom) -> void
    def self.from_xywh: (Numeric x, Numeric y, Numeric width, Numeric height) -> IRect
    def self.from_wh: (Numeric width, Numeric height) -> IRect
    def width: () -> Integer
    def height: () -> Integer
    def empty?: () -> bool
    def to_rect: () -> Rect
  end

  class RRect < Base
    def self.from_rect_xy: (Rect rect, Numeric radius_x, Numeric radius_y) -> RRect
    def self.from_rect: (Rect rect) -> RRect
    def rect: () -> Rect
  end

  class Matrix
    def self.identity: () -> Matrix
    def self.translation: (Numeric x, Numeric y) -> Matrix
    def self.scale: (Numeric x, Numeric y) -> Matrix
    def self.rotation: (Numeric degrees) -> Matrix
  end

  class SamplingOptions
    attr_reader filter: Symbol
    attr_reader mipmap: Symbol
    attr_reader cubic_b: Float?
    attr_reader cubic_c: Float?
    attr_reader max_anisotropy: Integer

    def initialize: (?filter: Symbol, ?mipmap: Symbol, ?cubic_b: Numeric?, ?cubic_c: Numeric?, ?max_anisotropy: Integer) -> void
    def self.default: () -> SamplingOptions
    def self.linear: (?mipmap: Symbol) -> SamplingOptions
    def self.cubic: (?b: Numeric, ?c: Numeric) -> SamplingOptions
  end

  class RotationScaleMatrix
    def initialize: (Numeric scale_cosine, Numeric scale_sine, Numeric translate_x, Numeric translate_y) -> void
    def self.identity: () -> RotationScaleMatrix
    def self.translation: (Numeric x, Numeric y) -> RotationScaleMatrix
    def self.create: (scale: Numeric, radians: Numeric, translate_x: Numeric, translate_y: Numeric, ?anchor_x: Numeric, ?anchor_y: Numeric) -> RotationScaleMatrix
  end

  class ImageInfo
    attr_reader width: Integer
    attr_reader height: Integer
    attr_reader color_type: Symbol
    attr_reader alpha_type: Symbol

    def initialize: (width: Integer, height: Integer, ?color_type: Symbol, ?alpha_type: Symbol, ?color_space: ColorSpace?) -> void
    def min_row_bytes: () -> Integer
    def compute_byte_size: (Integer row_bytes) -> Integer
  end

  class ColorSpace < Base
    def self.srgb: () -> ColorSpace
    def self.srgb_linear: () -> ColorSpace
    def srgb?: () -> bool
    def linear_gamma?: () -> bool
  end

  class Surface < Base
    attr_reader width: Integer
    attr_reader height: Integer

    def self.make_raster: (?Integer? width, ?Integer? height, ?image_info: ImageInfo?, ?color_type: Symbol, ?alpha_type: Symbol, ?color_space: ColorSpace?) -> Surface
                        | (?Integer? width, ?Integer? height, ?image_info: ImageInfo?, ?color_type: Symbol, ?alpha_type: Symbol, ?color_space: ColorSpace?) { (Surface) -> untyped } -> untyped
    def self.make_raster_direct: (?Integer? width, ?Integer? height, pixels: String | untyped, row_bytes: Integer, ?image_info: ImageInfo?, ?color_type: Symbol, ?alpha_type: Symbol, ?color_space: ColorSpace?) -> Surface
    def self.make_null: (Integer width, Integer height) -> Surface
    def canvas: () -> Canvas
    def snapshot: (?crop: Rect?) -> Image
    def peek_pixels: () -> Pixmap?
    def read_pixels: (**untyped options) -> String
    def draw: () { (Canvas) -> void } -> Surface
    def encode: (?Symbol format, ?Integer quality) -> Data
    def save: (String path, ?format: Symbol?, ?quality: Integer) -> Surface
    def save_png: (String path, ?Integer quality) -> Surface
    def save_jpeg: (String path, ?Integer quality) -> Surface
    def save_webp: (String path, ?Integer quality) -> Surface
  end

  class Canvas < Base
    def save: () -> Integer
    def save_layer: (?Rect? bounds, ?Paint? paint) -> Integer
    def restore: () -> void
    def restore_to_count: (Integer count) -> void
    def save_count: () -> Integer
    def translate: (Numeric dx, Numeric dy) -> Canvas
    def scale: (Numeric sx, ?Numeric sy) -> Canvas
    def rotate: (Numeric degrees, ?Numeric? px, ?Numeric? py) -> Canvas
    def rotate_radians: (Numeric radians) -> Canvas
    def skew: (Numeric sx, Numeric sy) -> Canvas
    def concat: (Matrix matrix) -> Canvas
    def matrix: () -> Matrix
    def matrix=: (Matrix matrix) -> Matrix
    def reset_matrix: () -> Canvas
    def clip_rect: (Rect rect, ?Symbol operation, ?antialias: bool) -> Canvas
    def clip_path: (Path path, ?Symbol operation, ?antialias: bool) -> Canvas
    def clip_rrect: (RRect rect, ?Symbol operation, ?antialias: bool) -> Canvas
    def clip_region: (Region region, ?Symbol operation) -> Canvas
    def quick_reject?: (Rect rect) -> bool
    def clear: (?(Color | Integer)) -> Canvas
    def draw_color: ((Color | Integer), ?Symbol blend_mode) -> Canvas
    def draw_paint: (Paint paint) -> Canvas
    def draw_rect: (Rect rect, Paint paint) -> Canvas
    def draw_rrect: (RRect rect, Paint paint) -> Canvas
    def draw_round_rect: (Rect rect, Numeric radius, Paint paint) -> Canvas
    def draw_arc: (Rect oval, Numeric start_angle, Numeric sweep_angle, bool use_center, Paint paint) -> Canvas
    def draw_circle: (Numeric x, Numeric y, Numeric radius, Paint paint) -> Canvas
    def draw_oval: (Rect rect, Paint paint) -> Canvas
    def draw_path: (Path path, Paint paint) -> Canvas
    def draw_region: (Region region, Paint paint) -> Canvas
    def draw_line: (Numeric x1, Numeric y1, Numeric x2, Numeric y2, Paint paint) -> Canvas
    def draw_point: (Numeric x, Numeric y, Paint paint) -> Canvas
    def draw_points: (Array[Point | [Numeric, Numeric]] points, Paint paint, ?mode: Symbol) -> Canvas
    def draw_image: (Image image, Numeric x, Numeric y, ?Paint? paint, ?sampling: SamplingOptions) -> Canvas
    def draw_image_rect: (Image image, Rect? source, Rect destination, ?Paint? paint, ?sampling: SamplingOptions) -> Canvas
    def draw_vertices: (Vertices vertices, Paint paint, ?blend_mode: Symbol) -> Canvas
    def draw_atlas: (Image atlas, sprites: Array[Rect], transforms: Array[RotationScaleMatrix], ?colors: Array[Color | Integer]?, ?blend_mode: Symbol, ?sampling: SamplingOptions, ?cull_rect: Rect?, ?paint: Paint?) -> Canvas
    def draw_patch: (Array[Point | [Numeric, Numeric]] cubics, Paint paint, ?colors: Array[Color | Integer]?, ?texture_coords: Array[Point | [Numeric, Numeric]]?, ?blend_mode: Symbol) -> Canvas
    def draw_text: (String text, Numeric x, Numeric y, Font font, Paint paint) -> Canvas
    def draw_text_on_path: (String text, Path path, Font font, Paint paint, ?offset: Numeric) -> Canvas
    def draw_shadow: (Path path, elevation: Numeric, ?ambient_color: Color, ?spot_color: Color, ?light_position: Point) -> Canvas
    def with_save: () { (Canvas) -> untyped } -> untyped
    def with_save_layer: (?Rect? bounds, ?Paint? paint) { (Canvas) -> untyped } -> untyped
  end

  class Paint < Base
    def initialize: (?untyped ptr) -> void
    def antialias?: () -> bool
    def antialias=: (bool value) -> bool
    def color: () -> Color
    def color=: ((Color | Integer) value) -> (Color | Integer)
    def style: () -> Symbol
    def style=: (Symbol value) -> Symbol
    def stroke_width: () -> Float
    def stroke_width=: (Numeric value) -> Numeric
    def stroke_cap: () -> Symbol
    def stroke_cap=: (Symbol value) -> Symbol
    def stroke_join: () -> Symbol
    def stroke_join=: (Symbol value) -> Symbol
    def stroke_miter: () -> Float
    def stroke_miter=: (Numeric value) -> Numeric
    def blend_mode: () -> Symbol
    def blend_mode=: (Symbol value) -> Symbol
    def blender: () -> Blender?
    def blender=: (Blender? value) -> Blender?
    def shader: () -> Shader?
    def shader=: (Shader? value) -> Shader?
    def mask_filter: () -> MaskFilter?
    def mask_filter=: (MaskFilter? value) -> MaskFilter?
    def color_filter: () -> ColorFilter?
    def color_filter=: (ColorFilter? value) -> ColorFilter?
    def image_filter: () -> ImageFilter?
    def image_filter=: (ImageFilter? value) -> ImageFilter?
    def path_effect: () -> PathEffect?
    def path_effect=: (PathEffect? value) -> PathEffect?
    def clone: () -> Paint
    def reset: () -> Paint
    def with: (**untyped options) -> Paint
  end

  class Path < Base
    def initialize: (?untyped ptr) -> void
    def self.build: () ?{ () -> void } -> Path
    def move_to: (Numeric x, Numeric y) -> Path
    def line_to: (Numeric x, Numeric y) -> Path
    def quad_to: (Numeric x1, Numeric y1, Numeric x2, Numeric y2) -> Path
    def conic_to: (Numeric x1, Numeric y1, Numeric x2, Numeric y2, Numeric weight) -> Path
    def cubic_to: (Numeric x1, Numeric y1, Numeric x2, Numeric y2, Numeric x3, Numeric y3) -> Path
    def close: () -> Path
    def add_rect: (Rect rect, ?Symbol direction) -> Path
    def add_rrect: (RRect rect, ?Symbol direction) -> Path
    def add_oval: (Rect rect, ?Symbol direction) -> Path
    def add_circle: (Numeric x, Numeric y, Numeric radius, ?Symbol direction) -> Path
    def add_path: (Path other, ?extend_path: bool) -> Path
    def fill_type: () -> Symbol
    def fill_type=: (Symbol value) -> Symbol
    def bounds: () -> Rect
    def empty?: () -> bool
    def count_points: () -> Integer
    def approximate_length: (?force_closed: bool, ?res_scale: Numeric) -> Float
    def measure: (?force_closed: bool, ?res_scale: Numeric) -> PathMeasure
    def op: (Path other, Symbol operation) -> Path?
    def union: (Path other) -> Path?
    def intersect: (Path other) -> Path?
    def difference: (Path other) -> Path?
    def xor: (Path other) -> Path?
    def reverse_difference: (Path other) -> Path?
    def simplify: () -> Path?
    def tight_bounds: () -> Rect?
    def to_svg_string: () -> String
    def contains?: (Numeric x, Numeric y) -> bool
    def transform: (Matrix matrix) -> Path
    def clone: () -> Path
    def reverse: () -> Path
    def reset: () -> Path
  end

  class PathMeasure < Base
    def initialize: (?Path? path, ?force_closed: bool, ?res_scale: Numeric) -> void
    def length: () -> Float
    def contour_closed?: () -> bool
    def path=: (Path? path) -> Path?
    def set_path: (Path? path, ?force_closed: bool) -> PathMeasure
    def position_tangent: (Numeric distance) -> [Point, Point]?
    def position: (Numeric distance) -> Point?
    def tangent: (Numeric distance) -> Point?
    def matrix: (Numeric distance, ?flags: Symbol) -> Matrix?
    def next_contour: () -> bool
  end

  class Region < Base
    include Enumerable[IRect]

    def initialize: (?IRect | Region | Path source) -> void
    def empty?: () -> bool
    def rect?: () -> bool
    def complex?: () -> bool
    def bounds: () -> IRect
    def boundary_path: () -> Path?
    def contains?: (Integer x, Integer y) -> bool
                 | (IRect | Region value) -> bool
    def intersects?: (IRect | Region value) -> bool
    def quick_contains?: (IRect rect) -> bool
    def quick_reject?: (IRect | Region value) -> bool
    def set_empty: () -> Region
    def set_rect: (IRect rect) -> Region
    def set_region: (Region region) -> Region
    def set_path: (Path path, ?clip: Region?) -> Region
    def translate: (Numeric x, Numeric y) -> Region
    def op: (IRect | Region value, Symbol operation) -> Region
    def each: () { (IRect) -> void } -> Region
             | () -> Enumerator[IRect, Region]
  end

  class Data < Base
    def initialize: ((String | untyped) bytes) -> void
    def self.from_file: (String path) -> Data
    def self.from_bytes: (String bytes) -> Data
    def size: () -> Integer
    def empty?: () -> bool
    def to_s: () -> String
    def to_bytes: () -> String
  end

  class Image < Base
    def self.from_file: (String path) -> Image
    def self.from_data: ((Data | String) data) -> Image
    def self.from_bitmap: (Bitmap bitmap) -> Image
    def width: () -> Integer
    def height: () -> Integer
    def unique_id: () -> Integer
    def color_type: () -> Symbol
    def alpha_type: () -> Symbol
    def color_space: () -> ColorSpace
    def encoded_data: () -> Data
    def make_shader: (?tile_x: Symbol, ?tile_y: Symbol, ?sampling: SamplingOptions, ?matrix: Matrix?) -> Shader
    def resize: (Numeric width, Numeric height, ?sampling: SamplingOptions) -> Image
    def scale: (Numeric factor, ?sampling: SamplingOptions) -> Image
    def subset: (IRect rect) -> Image?
    def read_pixels: (**untyped options) -> String
    def peek_pixels: () -> Pixmap?
    def encode: (?Symbol format, ?Integer quality) -> Data
    def save: (String path, ?format: Symbol?, ?quality: Integer) -> Image
  end

  class Codec < Base
    class FrameInfo
      attr_accessor required_frame: Integer
      attr_accessor duration: Integer
      attr_accessor fully_received: bool
      attr_accessor alpha_type: Symbol
      attr_accessor has_alpha_within_bounds: bool
      attr_accessor disposal_method: Symbol
      attr_accessor blend: Symbol
      attr_accessor rect: IRect
    end

    def self.from_file: (String path) -> Codec
    def self.from_data: (Data | String data) -> Codec
    def info: () -> ImageInfo
    def origin: () -> Symbol
    def format: () -> Symbol
    def frame_count: () -> Integer
    def repetition_count: () -> Integer
    def frame_info: (Integer index) -> FrameInfo?
    def frame_infos: () -> Array[FrameInfo?]
    def decode_frame: (?Integer index, ?image_info: ImageInfo?, ?apply_orientation: bool) -> Image
    def decode_frames: (?image_info: ImageInfo?, ?limit: Integer, ?apply_orientation: bool) -> Array[Image]
  end

  class Pixmap < Base
    def self.from_pixels: (ImageInfo image_info, String | Array[Integer] pixels, ?row_bytes: Integer?) -> Pixmap
    def self.from_numo: (untyped array, ?alpha_type: Symbol, ?color_space: ColorSpace?) -> Pixmap
    def info: () -> ImageInfo
    def row_bytes: () -> Integer
    def pixel_color: (Integer x, Integer y) -> Color
    def opaque?: () -> bool
    def read_pixels: (ImageInfo info, ?src_x: Integer, ?src_y: Integer, ?row_bytes: Integer?) -> String
    def to_numo: () -> untyped
    def extract_subset: (IRect rect) -> Pixmap?
    def reset: () -> Pixmap
  end

  class Vertices < Base
    def self.make_copy: (Symbol mode, Array[Point | [Numeric, Numeric]] positions, ?texture_coords: Array[Point | [Numeric, Numeric]]?, ?colors: Array[Color | Integer]?, ?indices: Array[Integer]?) -> Vertices
  end

  class Bitmap < Base
  end

  class Shader < Base
    def self.linear_gradient: (Point start_point, Point end_point, Array[Color | Integer] colors, ?Array[Numeric]? positions, ?tile_mode: Symbol, ?matrix: Matrix?) -> Shader
    def self.radial_gradient: (Point center, Numeric radius, Array[Color | Integer] colors, ?Array[Numeric]? positions, ?tile_mode: Symbol, ?matrix: Matrix?) -> Shader
  end

  class MaskFilter < Base
    def self.blur: (?Symbol style, sigma: Numeric, ?respect_ctm: bool?) -> MaskFilter
  end

  class ColorFilter < Base
    def self.mode: ((Color | Integer) color, ?Symbol blend_mode) -> ColorFilter
    def self.lighting: (Color | Integer multiply, Color | Integer add) -> ColorFilter
    def self.compose: (ColorFilter outer, ColorFilter inner) -> ColorFilter
    def self.lerp: (Numeric weight, ColorFilter from, ColorFilter to) -> ColorFilter
    def self.matrix: (Array[Numeric] values) -> ColorFilter
    def self.hsla_matrix: (Array[Numeric] values) -> ColorFilter
    def self.srgb_to_linear_gamma: () -> ColorFilter
    def self.linear_to_srgb_gamma: () -> ColorFilter
    def self.luma: () -> ColorFilter
    def self.table: (Array[Integer] values) -> ColorFilter
    def self.argb_table: (alpha: Array[Integer], red: Array[Integer], green: Array[Integer], blue: Array[Integer]) -> ColorFilter
  end

  class Blender < Base
    def self.mode: (Symbol blend_mode) -> Blender
    def self.arithmetic: (Numeric k1, Numeric k2, Numeric k3, Numeric k4, ?enforce_premul: bool) -> Blender
  end

  class ImageFilter < Base
    def self.blur: (Numeric sigma_x, Numeric sigma_y, ?tile_mode: Symbol, ?input: ImageFilter?, ?crop_rect: Rect?) -> ImageFilter
  end

  class PathEffect < Base
    def self.dash: (Array[Numeric] intervals, ?phase: Numeric) -> PathEffect
  end

  class Typeface < Base
  end

  class FontManager < Base
    include Enumerable[String]

    def self.default: () -> FontManager
    def family_count: () -> Integer
    def family_name: (Integer index) -> String
    def families: () -> Array[String]
    def each: () { (String) -> void } -> FontManager
             | () -> Enumerator[String, FontManager]
    def match_family: (String name, ?weight: Integer, ?width: Integer, ?slant: Symbol) -> Typeface?
    def match_character: (Integer | String character, ?family: String?, ?languages: Array[String], ?weight: Integer, ?width: Integer, ?slant: Symbol) -> Typeface?
    def make_from_file: (String path, ?index: Integer) -> Typeface
    def make_from_data: (Data | String data, ?index: Integer) -> Typeface
  end

  class Font < Base
    def initialize: (?Typeface? typeface, ?Numeric size, ?Numeric scale_x, ?Numeric skew_x) -> void
  end

  class TextBlob < Base
    def self.from_text: (String text, Font font, ?x: Numeric, ?y: Numeric, ?bounds: Rect?, ?encoding: Symbol) -> TextBlob?
    def self.from_text_on_path: (String text, Font font, Path path, ?offset: Numeric, ?bounds: Rect?) -> TextBlob?
    def bounds: () -> Rect
    def unique_id: () -> Integer
  end

  class RuntimeEffect < Base
    def self.make_for_shader: (String sksl) -> RuntimeEffect
    def self.make_for_color_filter: (String sksl) -> RuntimeEffect
    def self.make_for_blender: (String sksl) -> RuntimeEffect
    def make_shader: (?uniforms: Data | String?, ?children: Array[Base?], ?matrix: Matrix?) -> Shader
    def make_color_filter: (?uniforms: Data | String?, ?children: Array[Base?]) -> ColorFilter
    def make_blender: (?uniforms: Data | String?, ?children: Array[Base?]) -> Blender
    def uniform_byte_size: () -> Integer
    def uniform_names: () -> Array[String]
    def child_names: () -> Array[String]
  end


  module Svg
    def self.parse_path: (String data) -> Path
    def self.path_to_svg: (Path path) -> String
    def self.render: (Numeric width, Numeric height) { (Canvas) -> void } -> Data
    def self.save: (String path, width: Numeric, height: Numeric) { (Canvas) -> void } -> String
  end

  module Skottie
    class Animation < Base
      def self.make_from_json: (String json) -> Animation
      def self.make_from_file: (String path) -> Animation
    end

    class ResourceProvider < Base
      def self.file: (String base_directory, ?predecode: bool) -> ResourceProvider
      def self.data_uri: (?fallback: ResourceProvider?, ?predecode: bool) -> ResourceProvider
      def cached: () -> ResourceProvider
      def load: (String name, ?path: String) -> Data?
    end

    class AnimationBuilder < Base
      def initialize: (?flags: Integer | Array[Symbol]) -> void
      def font_manager=: (FontManager manager) -> FontManager
      def resource_provider=: (ResourceProvider provider) -> ResourceProvider
      def build_json: (String json) -> Animation
      def build_file: (String path) -> Animation
    end
  end
end
